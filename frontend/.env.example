# All settings are optional. In development the Vite dev server proxies /api and
# /health to the backend on the PORT configured in ../backend/.env.

# Backend the dev server proxies to (overrides the port from ../backend/.env)
# VITE_BACKEND_URL=http://localhost:3000

# Base URL of the API for production builds served from another origin
# VITE_API_BASE_URL=https://example.com/api

# Sent as X-API-KEY when the backend has API_KEY_REQUIRED=true.
# Note: this value is embedded in the browser bundle.
# VITE_API_KEY=

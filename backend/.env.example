# Server configuration
PORT=3000
NODE_ENV=development

# API security (send the key in the X-API-KEY header when required)
API_KEY_REQUIRED=false
API_KEY=
# Comma separated list of allowed origins; empty allows any origin
CORS_ORIGIN=

# Market data: https://www.alphavantage.co/support/#api-key
# The free tier allows 25 requests per day; responses are cached in CACHE_DIR
ALPHA_VANTAGE_API_KEY=
CACHE_DIR=.cache

# Portfolio decisions. Without a provider (or with USE_AI=false) the rule-based decision is used.
USE_AI=true
# openai | anthropic | none (default: whichever API key is set)
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Largest share of the portfolio a single position may take
MAX_POSITION_PCT=0.2
